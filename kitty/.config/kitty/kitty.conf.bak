# BEGIN_KITTY_THEME
include current-theme.conf
# END_KITTY_THEME

confirm_os_window_close 0
enable_audio_bell no
map ctrl+backspace send_text all \x17
cursor_shape beam

# BEGIN_KITTY_FONTS
font_family      family='Monaspace Radon' postscript_name=MonaspaceRadon-Regular
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS
