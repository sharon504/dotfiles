// --- Includes ---
// Load all modular configuration files
include "includes/startup.kdl"
include "includes/binds.kdl"
include "includes/input.kdl"
include "includes/outputs.kdl"
include "includes/theme.kdl"
include "includes/rules.kdl"

// --- General Settings ---

config-notification {
    disable-failed // Don't show a notification if a "spawn" command fails
}

switch-events {
  lid-close { spawn "hyprlock"; } // Lock the screen when the laptop lid is closed
}

hotkey-overlay {} // Settings for the hotkey overlay (Mod+Shift+Slash)

prefer-no-csd // Prefer server-side decorations (niri's borders) over client-side (app's built-in borders)

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png" // Set default path and filename format for screenshots

workspace "c" {}
workspace "b" {}
workspace "a" {}


gestures {
    hot-corners {
        off // Disable hot corners
    }
}
