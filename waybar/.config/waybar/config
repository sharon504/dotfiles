{
    // General Settings
    // Position TOP
    "layer": "top",
    // "margin-top": 4,
    // "margin-bottom": 1,

    // Position BOTTOM
    "position": "bottom",
    "margin-top": 0,
    "margin-bottom": 0,
    
    "layer": "top",
    "height": 30,
    "margin-left": 0,
    "margin-right": 0,    
    "spacing": 0,
    // Load Modules
    "include": ["~/.config/waybar/modules.json"],
    // "custom/appmenu",
    // Modules Left
    "modules-left": [
        "niri/window"
    ],
    // Modules Center
    // "modules-center": [
    //    "niri/workspaces"
    //],
    // Modules Right    
    "modules-right": [
        "group/quicklinks",
        "group/hardware",
        "network",
        "bluetooth",
        "pulseaudio",
        "backlight",
        "battery",
        "clock"
    ],
    // Group Quicklinks
    "group/quicklinks": {
        "orientation": "horizontal",
        "modules": [
            "custom/filemanager",
            "custom/brave"
         ]
    },
    // Group Hardware
    "group/hardware": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "memory"
        ]
    }
}
